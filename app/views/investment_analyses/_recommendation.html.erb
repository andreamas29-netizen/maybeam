<%# locals: (recommendation:, holding:) %>

<div class="bg-container rounded-xl shadow-border-xs p-5 space-y-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="font-medium text-primary"><%= recommendation["ticker"] %></p>
      <p class="text-sm text-secondary"><%= recommendation["name"] %></p>
    </div>

    <div class="text-right text-sm">
      <% if holding %>
        <p class="text-primary"><%= format_money(Money.new(holding["market_value"], holding["currency"])) %></p>
        <p class="text-secondary">
          <%= number_to_percentage(holding["portfolio_weight_pct"], precision: 1) %> of portfolio
          <% if holding["unrealized_return_pct"] %>
            · <%= tag.span number_to_percentage(holding["unrealized_return_pct"], precision: 1),
                          class: holding["unrealized_return_pct"].negative? ? "text-destructive" : "text-success" %>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <% InvestmentAnalysis::Agent::HORIZONS.each do |horizon, config| %>
      <% view = recommendation[horizon] || {} %>
      <div class="bg-surface-inset rounded-lg p-3 space-y-2">
        <div class="flex items-center justify-between">
          <p class="text-xs font-medium text-secondary uppercase"><%= config[:label] %></p>
          <%= investment_action_badge(view["action"]) %>
        </div>
        <p class="text-sm text-primary"><%= view["rationale"] %></p>
      </div>
    <% end %>
  </div>

  <div class="text-sm space-y-1">
    <p><span class="text-secondary">Conviction:</span> <span class="text-primary"><%= recommendation["conviction"].to_s.humanize %></span></p>
    <p><span class="text-secondary">Key risks:</span> <span class="text-primary"><%= recommendation["key_risks"] %></span></p>
  </div>
</div>
